        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.naive_bayes import MultinomialNB\n",
        "from sklearn.metrics import accuracy_score\n",
        "\n",
        "# 1. Load real SMS Spam dataset directly from URL\n",
        "url = \"https://raw.githubusercontent.com/mohitgupta-omg/Kaggle-SMS-Spam-Collection-Dataset-/master/spam.csv\"\n",
        "df = pd.read_csv(url, encoding='latin-1')\n",
        "# The dataset has columns 'v1' (label) and 'v2' (message), let's rename them\n",
        "df = df[['v1', 'v2']].rename(columns={'v1': 'label', 'v2': 'message'})\n",
        "\n",
        "print(\"First 5 messages in dataset:\")\n",
        "print(df.head())\n",
        "\n",
        "# 2. Convert labels ('ham' -> 0, 'spam' -> 1)\n",
        "df['label_num'] = df.label.map({'ham': 0, 'spam': 1})\n",
        "\n",
        "# 3. Split data into Training (80%) and Testing (20%)\n",
        "X_train, X_test, y_train, y_test = train_test_split(df['message'], df['label_num'], test_size=0.2, random_state=42)\n",
        "\n",
        "# 4. NLP Step: Convert text into numbers using TF-IDF\n",
        "vectorizer = TfidfVectorizer(stop_words='english')\n",
        "X_train_tfidf = vectorizer.fit_transform(X_train)\n",
        "X_test_tfidf = vectorizer.transform(X_test)\n",
        "\n",
        "# 5. Train Naive Bayes Classifier\n",
        "model = MultinomialNB()\n",
        "model.fit(X_train_tfidf, y_train)\n",
        "\n",
        "# 6. Check Model Accuracy\n",
        "predictions = model.predict(X_test_tfidf)\n",
        "print(f\"\\nModel Accuracy: {accuracy_score(y_test, predictions) * 100:.2f}%\")\n",
        "\n",
        "# 7. Test with your own custom messages!\n",
        "custom_messages = [\n",
        "    \"Congratulations! You won a FREE iPhone 15. Click here to claim now!\",\n",
        "    \"Bro, are we going to college tomorrow for DL lab?\"\n",
        "]\n",
        "custom_tfidf = vectorizer.transform(custom_messages)\n",
        "results = model.predict(custom_tfidf)\n",
        "\n",
        "print(\"\\nCustom Predictions:\")\n",
        "for msg, res in zip(custom_messages, results):\n",
        "    tag = \"SPAM 🚨\" if res == 1 else \"NOT SPAM (Normal) ✅\"\n",
        "    print(f\"Message: '{msg}' -> {tag}\")"
      ],
